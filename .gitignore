# Go项目忽略规则
# 二进制文件
*.exe
*.exe~
*.dll
*.so
*.dylib
prerender-shield
/api

# 依赖包目录
gopkg.in/
vendor/

# 编译产物
__pycache__/
bin/

# 编译产生的目录
# 注意：不忽略测试文件
api/
!api/*_test.go
!internal/api/
!internal/api/*_test.go
!internal/api/routes/
!internal/api/routes/*_test.go

# 各平台运行时目录
bin/*/certs/
bin/*/config/
bin/*/data/
bin/*/static/
bin/*/logs/
bin/*/web/

# Go编译产生的文件
*.o
*.a
*.test
*.out

# 编辑器配置文件
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# 环境变量文件
.env
.env.local
.env.*.local

# 配置文件（如果不需要提交）
configs/config.yml
configs/*.local.yml
config.yml
config/

# 日志文件
*.log
/logs/

# 临时文件
tmp/
temp/
*.token
.token
*.pid
.pid

# Docker相关文件（如果不需要提交）
# docker-compose.override.yml

# 前端项目忽略规则
node_modules/
web/node_modules/
web/build/
web/.eslintcache
web/*.local
web/.env
web/.env.local
web/.env.*.local
web/dist/

# 数据库文件
data/
!data/.gitkeep
*/data/
!*/data/.gitkeep

# 证书文件
/etc/prerender-shield/certs/
certs/
*/certs/

# 浏览器文件
browser/

#资源文件
/static/

# Trace文件
.trace

# Trae IDE 配置目录
.trae/

# 测试产物
test-results/
web/test-results/
web/coverage/
coverage.html

# 前端测试目录
web/src/**/__tests__/**/*.test.tsx.snap
docs/

# 本地构建产物与系统文件
/api
/bin/
.DS_Store
*.tmp.*
